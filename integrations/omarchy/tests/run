#!/usr/bin/env python3
import json
import pathlib
import py_compile
import sys
import tempfile

root = pathlib.Path(__file__).resolve().parent.parent
manifest = json.loads((root / "manifest.json").read_text())
assert manifest["schemaVersion"] == 1
assert manifest["id"] == "io.github.feedlizard.bar"
assert manifest["kinds"] == ["bar-widget"]
assert manifest["entryPoints"]["barWidget"] == "FeedLizard.qml"
assert (root / manifest["entryPoints"]["barWidget"]).is_file()

helper = root / "bin" / "feedlizard-ipc"
with tempfile.TemporaryDirectory() as directory:
    py_compile.compile(str(helper), cfile=str(pathlib.Path(directory) / "feedlizard-ipc.pyc"), doraise=True)
source = helper.read_text()
for method in ("OpenFeedLizard", "OpenUnread", "Refresh"):
    assert method in source
for forbidden in ("nsec", "sqlite3", "SELECT ", "shell=True"):
    assert forbidden not in source
assert '"--omarchy"' in source
assert 'sys.argv[1:] == ["launch"]' in source

qml = (root / "FeedLizardService.qml").read_text()
assert "Timer {" not in qml
assert "gdbus" not in qml
assert "feedlizard-ipc" in qml
assert "UnreadChanged" in qml
assert "Qt.resolvedUrl" in qml
assert '[root.helperPath, "launch"]' in qml

print("FeedLizard Omarchy source checks passed")
