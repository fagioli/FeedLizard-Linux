#!/usr/bin/env python3
"""Narrow host-side adapter for FeedLizard's session D-Bus interface."""

import ast
import os
import shutil
import subprocess
import sys

SERVICE = "io.github.feedlizard.FeedLizard.Integration"
PATH = "/io/github/feedlizard/FeedLizard/Integration"
INTERFACE = "io.github.feedlizard.FeedLizard.Integration1"
ALLOWED = {"OpenFeedLizard", "OpenUnread", "Refresh"}


def gdbus(*arguments: str, capture: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["gdbus", *arguments],
        check=False,
        capture_output=capture,
        text=True,
        timeout=None,
    )


def state() -> int:
    result = gdbus(
        "call", "--session", "--dest", SERVICE, "--object-path", PATH,
        "--method", f"{INTERFACE}.GetUnreadState",
    )
    if result.returncode != 0:
        return result.returncode
    try:
        value = ast.literal_eval(result.stdout.strip())
        if not isinstance(value, tuple) or len(value) != 1 or not isinstance(value[0], str):
            return 2
        print(value[0])
        return 0
    except (SyntaxError, ValueError):
        return 2


def call(method: str) -> int:
    if method not in ALLOWED:
        return 2
    return gdbus(
        "call", "--session", "--dest", SERVICE, "--object-path", PATH,
        "--method", f"{INTERFACE}.{method}", capture=False,
    ).returncode


def monitor() -> int:
    return gdbus(
        "monitor", "--session", "--dest", SERVICE, "--object-path", PATH,
        capture=False,
    ).returncode


def launch() -> int:
    """Launch FeedLizard's explicit Omarchy presentation without a shell."""
    command = None
    flatpak = shutil.which("flatpak")
    if flatpak:
        installed = subprocess.run(
            [flatpak, "info", "io.github.feedlizard.FeedLizard"],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if installed.returncode == 0:
            command = [flatpak, "run", "io.github.feedlizard.FeedLizard", "--omarchy"]
    if command is None and (binary := shutil.which("feedlizard")):
        command = [binary, "--omarchy"]
    if command is None:
        return 127
    subprocess.Popen(
        command,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
        env=os.environ.copy(),
    )
    return 0


if __name__ == "__main__":
    if sys.argv[1:] == ["state"]:
        raise SystemExit(state())
    if len(sys.argv) == 3 and sys.argv[1] == "call":
        raise SystemExit(call(sys.argv[2]))
    if sys.argv[1:] == ["monitor"]:
        raise SystemExit(monitor())
    if sys.argv[1:] == ["launch"]:
        raise SystemExit(launch())
    raise SystemExit(2)
