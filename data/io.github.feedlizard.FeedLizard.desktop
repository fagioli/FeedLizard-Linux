[Desktop Entry]
Name=FeedLizard
Comment=Read RSS, Atom, and JSON feeds
Exec=feedlizard %U
Icon=io.github.feedlizard.FeedLizard
Terminal=false
Type=Application
Categories=Network;News;
Keywords=RSS;Atom;Feeds;News;Reader;
StartupNotify=true
MimeType=application/rss+xml;application/atom+xml;application/feed+json;text/x-opml;
